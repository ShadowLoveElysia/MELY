{
  "name": "mely",
  "private": true,
  "type": "module",
  "scripts": {
    "prestart:desktop": "npm run version:sync && npm run version:check",
    "start": "npm run start:desktop",
    "start:desktop": "node node_modules/@tauri-apps/cli/tauri.js dev",
    "start:web": "node scripts/start-web.mjs",
    "predev:desktop": "npm run version:sync && npm run version:check",
    "dev": "npm run dev:desktop",
    "dev:desktop": "node node_modules/@tauri-apps/cli/tauri.js dev",
    "dev:web": "node node_modules/vite/bin/vite.js --config vite.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "prebuild:desktop": "npm run version:sync && npm run version:check",
    "build": "npm run build:desktop",
    "build:desktop": "node node_modules/@tauri-apps/cli/tauri.js build",
    "typecheck": "node node_modules/typescript/bin/tsc -b",
    "build:web": "npm run typecheck && node node_modules/vite/bin/vite.js build --config vite.config.ts",
    "validate:web": "npm run version:check && npm run typecheck && npm test && node node_modules/vite/bin/vite.js build --config vite.config.ts",
    "tauri": "node node_modules/@tauri-apps/cli/tauri.js",
    "pretauri": "npm run version:sync && npm run version:check",
    "preview": "npm run preview:web",
    "preview:web": "node node_modules/vite/bin/vite.js preview --config vite.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "test": "npm run version:check && node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:parallel": "npm run version:check && node --import tsx --test tests/*.test.ts",
    "version:check": "node scripts/version.mjs check",
    "version:sync": "node scripts/version.mjs sync"
  },
  "dependencies": {
    "@babylonjs/core": "9.20.0",
    "@moeru/three-mmd": "0.1.1",
    "@moeru/three-mmd-physics-ammo": "0.1.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@yohawing/three-mmd-loader": "^0.8.1",
    "ammojs-typed": "1.0.6",
    "babylon-mmd": "1.3.0",
    "buffer": "^6.0.3",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "nbt-ts": "^1.3.6",
    "pako": "^2.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1",
    "three-stdlib": "2.36.1"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^24.0.0",
    "@types/pako": "^2.0.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prismarine-nbt": "^2.8.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
